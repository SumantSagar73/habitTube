{
  "manifest_version": 3,
  "name": "HabitTube Focus",
  "version": "1.0.0",
  "description": "Blocks distracting sites during HabitTube focus sessions — only your study allowlist gets through.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HabitTube Focus" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://habit-tube.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.github.io/*",
        "https://*.netlify.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
